<?xml version="1.0"?>
<!--
    Sync log grid.

    Column choice is driven by the questions support actually asks: did this order
    reach Bob Go, which direction was the traffic, what did the API say, and was
    this delivery a duplicate. Payload is present but not filterable — it is a
    redacted JSON blob, useful to read and pointless to search.
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">bobgo_sync_log_listing.bobgo_sync_log_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>bobgo_sync_log_columns</spinner>
        <deps>
            <dep>bobgo_sync_log_listing.bobgo_sync_log_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="bobgo_sync_log_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>BobGroup_BobGo::sync_log</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="bobgo_sync_log_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
        </filters>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="bobgo_sync_log_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">bobgo_sync_log_listing.bobgo_sync_log_listing.bobgo_sync_log_columns</item>
                </param>
            </childDefaults>
        </settings>

        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>

        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Occurred</label>
                <timezone>true</timezone>
            </settings>
        </column>

        <column name="order_id" sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order ID</label>
            </settings>
        </column>

        <column name="direction" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options>
                    <option name="inbound" xsi:type="array">
                        <item name="value" xsi:type="string">inbound</item>
                        <item name="label" xsi:type="string" translate="true">Inbound</item>
                    </option>
                    <option name="outbound" xsi:type="array">
                        <item name="value" xsi:type="string">outbound</item>
                        <item name="label" xsi:type="string" translate="true">Outbound</item>
                    </option>
                </options>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Direction</label>
            </settings>
        </column>

        <column name="event_type" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Event</label>
            </settings>
        </column>

        <column name="success" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Succeeded</label>
            </settings>
        </column>

        <column name="http_status" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">HTTP</label>
            </settings>
        </column>

        <!--
            The dedup key. A row with an event_id is one Bob Go delivery; a NULL
            here on a failure row is deliberate, so the retry can re-claim the slot.
        -->
        <column name="event_id" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Event ID</label>
            </settings>
        </column>

        <column name="payload" sortOrder="90">
            <settings>
                <label translate="true">Payload (PII redacted)</label>
                <filter>false</filter>
                <sortable>false</sortable>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>
    </columns>
</listing>
