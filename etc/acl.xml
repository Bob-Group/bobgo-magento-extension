<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Sales::sales">
                    <!--
                        Its own resource rather than borrowing a Sales one, so a
                        merchant can give support staff the log without granting
                        order editing.
                    -->
                    <resource id="BobGroup_BobGo::sync_log" title="Bob Go Sync Log" sortOrder="100"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
