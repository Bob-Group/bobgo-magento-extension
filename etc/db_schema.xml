<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_order" resource="sales" comment="Sales Order">
        <column xsi:type="varchar" name="bobgo_order_id" nullable="true" length="255" comment="Bob Go Order ID"/>
    </table>
    <table name="sales_order_item" resource="sales" comment="Sales Order Item">
        <column xsi:type="varchar" name="bobgo_order_item_id" nullable="true" length="255"
                comment="Bob Go Order Item ID"/>
    </table>
</schema>
