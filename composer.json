{
    "name": "bobgo/bobgo-magento-extension",
    "description": "Smart shipping and order management solution in South Africa",
    "type": "magento2-module",
    "version": "1.1.0",
    "authors": [
        {
            "name": "Bob Go",
            "email": "support@bobgo.co.za",
            "homepage": "https://www.bobgo.co.za"
        }
    ],
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^7.4 || ^8.0 || ^8.2"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BobGroup\\BobGo\\": ""
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "scripts": {
        "test": "phpunit --prepend Test/stubs/autoload-prepend.php --bootstrap Test/bootstrap.php Test/Unit/",
        "stan": "phpstan analyse --no-progress",
        "check": [
            "@stan",
            "@test"
        ]
    }
}
